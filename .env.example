# ==============================================================================
# SMTP & Cold Outreach Configuration
# ==============================================================================
# Leave blank or fill with your SMTP details when ready.
# Works with Gmail (use App Password), Zoho, Outlook, Sendgrid, AWS SES, or custom domain.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password_here

# Sender Details
FROM_NAME="Divyanshu Vaibhav | Patent & IP Research Specialist"
FROM_EMAIL=your_email@example.com
REPLY_TO=your_email@example.com

# Outreach Throttling & Safety
# Max emails to send per batch/run to protect domain reputation (recommended: 15-25)
DAILY_SEND_LIMIT=20
# Delay between consecutive emails in milliseconds (default: 8000 = 8s)
SEND_DELAY_MS=8000
