# Committed demo config for local development against the Firebase Emulator Suite.
# `npm run emulators` in one terminal, `npm run dev:emu` in another. No real project, no secrets.
VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-city-siege
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-city-siege.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_EMULATOR_PORT=9099
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8085
VITE_MCP_SERVER_URL=http://localhost:8787/mcp
