# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
# Firebase web config values are not secrets (they identify the project); security comes from
# firestore.rules. Leave VITE_FIREBASE_API_KEY empty to play fully offline.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# true = talk to the local Firebase Emulator Suite instead of the real project
VITE_FIREBASE_EMULATORS=false
# Public URL of your hosted MCP server (Streamable HTTP), shown in the in-game setup snippets
VITE_MCP_SERVER_URL=http://localhost:8787/mcp
